# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
# DEV_ADMIN — может всё + тестовые алерты
DEV_ADMIN=111111111
# ADMIN — может всё, кроме тестовых алертов
ADMIN=222222222,333333333

# Часовой пояс для напоминаний
TZ=Europe/Moscow

# Путь к базе SQLite
DB_PATH=data/birthdays.db

# Время напоминаний «за N дней» при первом запуске (дальше меняется в боте)
REMIND_AT=09:00

# Rich Messages: auto — rich с откатом на обычные сообщения при ошибке,
# on — только rich, off — только обычные сообщения с inline-кнопками
RICH_MODE=auto

# Уровень логов: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
